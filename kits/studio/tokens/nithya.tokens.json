{
  "$description": "Nithya design tokens. Single source for the Flutter and web builds; run `node tokens/build.mjs` after editing.",
  "font": {
    "display": "PlusJakartaSans",
    "body": "Inter"
  },
  "type": {
    "hero": { "family": "display", "size": 60, "weight": 800, "tracking": -1.8, "height": 1.05 },
    "title": { "family": "display", "size": 28, "weight": 800, "tracking": -0.6, "height": 1.15 },
    "heading": { "family": "display", "size": 17, "weight": 700, "tracking": -0.2, "height": 1.3 },
    "body": { "family": "body", "size": 14, "weight": 400, "tracking": 0, "height": 1.45 },
    "label": { "family": "body", "size": 13, "weight": 600, "tracking": 0, "height": 1.3 },
    "caption": { "family": "body", "size": 12, "weight": 400, "tracking": 0, "height": 1.4 },
    "overline": { "family": "body", "size": 11, "weight": 700, "tracking": 1.2, "height": 1.3 }
  },
  "space": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "huge": 48 },
  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "xxl": 24, "pill": 999 },
  "size": {
    "topBar": 56,
    "control": 36,
    "toolTile": 44,
    "promptDock": 980,
    "dialog": 560,
    "sideNav": 232,
    "outliner": 260
  },
  "motion": { "fast": 120, "base": 180, "slow": 280 },
  "accent": {
    "primary": "#3D7BFF",
    "onPrimary": "#FFFFFF",
    "danger": "#E5484D",
    "success": "#2FB67C",
    "warning": "#F2A93B"
  },
  "hues": {
    "blue": "#5B8DEF",
    "amber": "#E8B04A",
    "rose": "#E46A9B",
    "green": "#3FBF8F",
    "sky": "#4FB3E8",
    "lime": "#A5CF4C",
    "slate": "#98A2B3",
    "violet": "#A07BF0",
    "red": "#EC6A5E",
    "teal": "#2EC4B6"
  },
  "badges": { "new": "teal", "beta": "amber", "soon": "slate" },
  "themes": {
